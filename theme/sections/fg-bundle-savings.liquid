<script>
(function () {
  // Tells the shared sheet a script is alive, so its .m-* primitives may arm.
  // Idempotent — every component's IIFE does this and the class is set once.
  document.documentElement.classList.add('fg-js');

  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var roots = document.querySelectorAll('.fg-bundle');

  Array.prototype.forEach.call(roots, function (root) {
    // Reduced motion: never arm. The base CSS is already the resolved frame,
    // so every number is on screen, still and readable.
    if (reduce) { return; }

    root.classList.add('is-armed');

    // Idempotent: it only adds a class, so any number of callers may race.
    function play() { root.classList.add('is-on'); }

    // Focus must never land on a control that is still parked at opacity 0.
    // The buy CTA and the free-sample link are focusable from the first frame
    // but invisible until 850ms, so the first time focus enters the component
    // we pin the whole thing to its resolved end frame and stop animating.
    function onFocusIn() {
      root.classList.add('is-done');
      root.removeEventListener('focusin', onFocusIn);
    }
    root.addEventListener('focusin', onFocusIn);

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) { play(); io.disconnect(); return; }
        }
      }, { threshold: 0.01 });
      io.observe(root);
    } else {
      play();
    }

    // Backstop, viewport-checked. A price must never be stranded at opacity 0
    // because an observer was throttled or never fired — but the rescue only
    // applies to a card that is ON SCREEN and has not already played. An
    // unconditional timer would burn the reveal of every section below the
    // fold, so the shopper scrolls down to animations that already finished.
    window.setTimeout(function () {
      if (root.classList.contains('is-on')) { return; }
      var r = root.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      if (r.bottom > 0 && r.top < vh) { play(); }
    }, 1200);
  });
})();


(function(){
  var c=document.querySelector('.fg-bundle .cta');if(!c)return;
  c.addEventListener('click',function(e){
    var f=document.querySelector('product-form, form[action*="/cart/add"]');
    if(f){e.preventDefault();f.scrollIntoView({
      behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',
      block:'center'});}
  });
})();</script>
