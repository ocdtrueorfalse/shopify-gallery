      "settings": {
        "kicker": "Straight answers",
        "heading": "Everything you'd want to know before spending anything",
        "author_name": "Julian",
        "author_line": "Not a clinician — these are self-practice materials built from published ERP methods, not treatment.",
        "contact_email": "ocdtrueorfalse@gmail.com"
      }
    },
    "fg_ocd_says": {
      "type": "fg-ocd-says",
      "settings": {
        "kicker": "OCD says / Reality",
        "heading": "Three more your mind gets backwards",
        "pairs": "You need to be certain before you can move on. :: Certainty is the one thing OCD promises and never delivers. You can move before the doubt clears.\nChecking one more time will finally settle it. :: Every check teaches the doubt to come back louder. That is why it never stays settled.\nIf you cannot stop thinking about it, it must be important. :: Attention is not evidence. OCD grabs the loudest thought, not the truest one.",
        "turn_head": "So why does knowing this not make it stop?",
        "turn_body": "Because understanding a loop does not switch it off. Reassurance wears off by design — that is why the relief never lasts more than an hour, and why you end up back at the same question by evening. <strong>What changes it is practice.</strong> Small, repeatable exposures you work through on paper, one page at a time. That is what these three workbooks are.",
        "cta_label": "Start the practice",
        "show_price": true
      }
    },
